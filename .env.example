# Required before a production Web build. Use the canonical HTTPS origin without
# a trailing slash so Next.js can generate stable absolute Open Graph and sitemap URLs.
# Example: https://mentor-bti.example.com
NEXT_PUBLIC_SITE_URL=

# These variables belong to a Supabase project you control. Without them, the
# public pages render, while sign-in and authenticated testing are unavailable.
# Keep the secret key server-only. Never use a NEXT_PUBLIC_ prefix for it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback, only if this project still uses a service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=

# Required for email/password sign-in, cloud 48-item results and account feedback.
# These two ARE meant for the browser: the publishable key carries no privileges
# of its own, and every table it can reach is fenced by row-level security that
# keys off the signed-in user. Sign-in is unavailable while they are unset.
# The secret key above is a different key and must never be given a
# NEXT_PUBLIC_ prefix. Never put the two in the same variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional UTC timestamp for the public page-view and completed-test counters.
# Registered accounts always reflect the current total in Supabase Auth.
PUBLIC_METRICS_START_AT=
